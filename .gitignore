# mustafar runtime artifacts (prune ctrl log, serve logs, bytecode)
mustafar/ctrl/
mustafar/logs/
mustafar/__pycache__/
**/__pycache__/

# Raw per-leg measurement outputs (470M jsonl/csv/log, regenerable)
mustafar/results/

# setuptools build_ext scratch (in-place builds; regenerable, and its generated
# ninja files embed whatever extension names were current when it ran)
/build/

# Compiled CUDA extensions — regenerable via cuda/setup.py build_ext, and
# specific to one torch/CUDA version and one SM arch. Never tracked here.
*.so

# LongBench v2 dataset copy (903M, regenerable from transferibility/data/longbench)
mustafar/data/

# LIVE auth token / env config — never commit
mustafar/scripts/**/config.json
mustafar/scripts/config.json
mustafar/scripts/local/config/config_deepswe.json
mustafar/scripts/local/config/config_swe_sangfor.json

# starkv runtime artifacts: the store/serve debug logs and the retention
# telemetry curve
starkv/ctrl/
starkv/logs/

# Per-layer capture shards (.pt, hundreds of MB). Large, and regenerable -- but
# only with GPU time through the scheduler, so they stay out of the repo.
starkv/captures/
starkv/basis/

# The spectrum/stability tables under starkv/results/ ARE tracked: they are small
# (a few hundred KB) and they are the evidence behind report.md's numbers.
# Ignoring them would leave the report citing files a reader cannot open.
