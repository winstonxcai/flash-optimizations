# Keep the docker build context small: local.Dockerfile/modal.Dockerfile only
# COPY remnant/, so exclude the repo's runtime artifacts and regenerable data.
# Mirrors .gitignore (git is orthogonal to the build context).
.git/
**/.git/
third_party/sglang/.git
third_party/flashmla/.git
log/
writeup/
xkv/
**/__pycache__/
*.pyc

# remnant runtime artifacts + regenerable datasets (see .gitignore)
remnant/ctrl/
remnant/logs/
remnant/data/
remnant/results/
remnant/scripts/**/config.json
