# Keep the docker build context small: local.Dockerfile/modal.Dockerfile only
# COPY mustafar/, so exclude the repo's runtime artifacts and regenerable data.
# Mirrors .gitignore (git is orthogonal to the build context).
.git/
log/
writeup/
xkv/
**/__pycache__/
*.pyc

# mustafar runtime artifacts + regenerable datasets (see .gitignore)
mustafar/ctrl/
mustafar/logs/
mustafar/data/
mustafar/results/
mustafar/scripts/**/config.json

# starkv runtime artifacts. The starkv/ package itself MUST stay in the context
# (local.Dockerfile COPYs it), so only the dirs it writes at run time are
# excluded -- captures in particular, which are hundreds of MB of .pt.
starkv/ctrl/
starkv/logs/
starkv/results/
starkv/captures/
starkv/basis/
starkv/**/__pycache__/
