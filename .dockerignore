# Exclude runtime artifacts and regenerable data from both integration images.
# Docker COPY selects the fork pair; .gitignore does not control build contexts.
.git/
data/
raw/
results/
logs/
benchmarks/
transfer/
**/.git/
**/.git
third_party/sglang-v0.5.18/.git
third_party/flashmla-v0.5.18/.git
log/
writeup/
xkv/
**/__pycache__/
*.pyc

# remnant runtime artifacts + regenerable datasets (see .gitignore)
remnant/ctrl/
remnant/logs/
remnant/data/
remnant/results/
remnant/scripts/**/config.json
